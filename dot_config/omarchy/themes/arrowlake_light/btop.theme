# Theme: arrowlake_light
# By: Jadon Brutcher

theme[main_bg]="#ebe0cf"
theme[main_fg]="#54473f"

# Title color for boxes
theme[title]="#54473f"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#CF9978"

# Selected item in processes box
theme[selected_bg]="#d4c6b3"
theme[selected_fg]="#56AEA9"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#56AEA9"

# Cpu box outline color
theme[cpu_box]="#6660AF"

# Memory/disks box outline color
theme[mem_box]="#6660AF"

# Net up/down box outline color
theme[net_box]="#6660AF"

# Processes box outline color
theme[proc_box]="#6660AF"

# Box divider line and small boxes line color
theme[div_line]="#6660AF"

# Temperature graph colors
theme[temp_start]="#4E7469"
theme[temp_mid]="#AE984C"
theme[temp_end]="#BC495D"

# CPU graph colors
theme[cpu_start]="#4E7469"
theme[cpu_mid]="#AE984C"
theme[cpu_end]="#BC495D"

# Mem/Disk free meter
theme[free_start]="#4E7469"
theme[free_mid]="#AE984C"
theme[free_end]="#BC495D"

# Mem/Disk cached meter
theme[cached_start]="#4E7469"
theme[cached_mid]="#AE984C"
theme[cached_end]="#BC495D"

# Mem/Disk available meter
theme[available_start]="#4E7469"
theme[available_mid]="#AE984C"
theme[available_end]="#BC495D"

# Mem/Disk used meter
theme[used_start]="#4E7469"
theme[used_mid]="#AE984C"
theme[used_end]="#BC495D"

# Download graph colors
theme[download_start]="#4E7469"
theme[download_mid]="#AE984C"
theme[download_end]="#BC495D"

# Upload graph colors
theme[upload_start]="#4E7469"
theme[upload_mid]="#AE984C"
theme[upload_end]="#BC495D"
