#!/bin/bash

# Preserve an explicit disable decision on every Omarchy install. The Ubuntu
# compat setup records one under omarchy-ubuntu/; the generic marker lets the
# same decision hold on a native Arch install.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
for marker in "$state_dir/omarchy/agents/usage-disabled" \
  "$state_dir/omarchy-ubuntu/agent-usage-disabled"; do
  [[ ! -e $marker ]] || exit 0
done
list_collectors=false
if [[ ${1:-} == --list-collectors ]]; then list_collectors=true; shift; fi

# omarchy:summary=Regenerate the AI agent usage data files
# omarchy:args=[--force] [--limits-only] [--except <agent>] [agent...]
# omarchy:examples=omarchy agent usage-update | omarchy agent usage-update claude | omarchy agent usage-update --except codex

# Each omarchy-agent-usage-<agent> collector prints one display-ready JSON
# record; this writes them to ~/.local/state/omarchy/agents/usage/ where the
# agents panel watches them. Adding an agent is adding a collector — the
# panel picks up any record that appears here.

USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
mkdir -p "$USAGE_DIR"

flags=()
only=()
declare -A excluded

while [[ $# -gt 0 ]]; do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    if [[ $# -lt 2 || -z $2 ]]; then
      echo "omarchy-agent-usage-update: --except requires an agent" >&2
      exit 2
    fi
    excluded[$2]=1
    shift
    ;;
  -*)
    echo "omarchy-agent-usage-update: unknown option: $1" >&2
    exit 2
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  local agent="$1"
  [[ -n ${excluded[$agent]} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

collect() {
  local collector="$1" agent="$2"
  local record tmp
  if ! record=$("$collector" "${flags[@]}") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "omarchy-agent-usage-update: $agent collector failed" >&2
    return 1
  fi
  tmp=$(mktemp "$USAGE_DIR/.$agent.XXXXXX") || return 1
  # A failed or interrupted write must not leave mktemp debris in the watched
  # usage directory; the panel discovers every *.json file there.
  trap 'rm -f -- "$tmp"' EXIT
  if ! printf '%s\n' "$record" >"$tmp" || ! mv -- "$tmp" "$USAGE_DIR/$agent.json"; then
    echo "omarchy-agent-usage-update: $agent record write failed" >&2
    return 1
  fi
  trap - EXIT
}

pids=()
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# Native collectors sit beside the Omarchy install, whose root differs between
# a packaged system and a per-user checkout. Probe the documented locations
# instead of assuming /usr/bin, and fall back to PATH for anything else.
native_collector() {
  local name="$1" root
  for root in "${OMARCHY_PATH:-}" "$HOME/.local/share/omarchy" \
    /usr/share/omarchy /usr; do
    [[ -n $root ]] || continue
    if [[ -x $root/bin/$name ]]; then
      printf '%s\n' "$root/bin/$name"
      return 0
    fi
  done
  command -v "$name" 2>/dev/null
}

collectors=()
for name in omarchy-agent-usage-claude omarchy-agent-usage-codex \
  omarchy-agent-usage-fireworks; do
  collector=$(native_collector "$name") || continue
  [[ -n $collector ]] && collectors+=("$collector")
done
collectors+=(
  "$script_dir/collectors/omarchy-agent-usage-opencode-go"
  "$script_dir/collectors/omarchy-agent-usage-deepseek"
)

for collector in "${collectors[@]}"; do
  [[ -x $collector ]] || continue
  agent="${collector##*/omarchy-agent-usage-}"
  # dpkg replacement/backup files are not collectors. In particular,
  # update.dpkg-tmp would recursively launch this updater.
  [[ $agent =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ && $agent != update ]] || continue
  [[ ! $collector -ef ${BASH_SOURCE[0]} ]] || continue
  if $list_collectors; then printf '%s\n' "$collector"; continue; fi
  wanted "$agent" || continue
  collect "$collector" "$agent" &
  pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
exit $status
