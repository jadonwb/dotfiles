#!/usr/bin/env python3
"""Read DeepSeek's actual prepaid balance for the native agents panel."""
import argparse
from datetime import datetime, timezone
from decimal import Decimal, InvalidOperation
import json
import math
import os
from pathlib import Path
import subprocess
import tempfile
import time
import urllib.error
import urllib.request

ENDPOINT = 'https://api.deepseek.com/user/balance'


class BalanceError(Exception):
    pass


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def api_key():
    if os.environ.get('DEEPSEEK_API_KEY'):
        return os.environ['DEEPSEEK_API_KEY']
    try:
        result = subprocess.run(['opencode', 'auth', 'export', 'deepseek'],
                                cwd=Path.home(), capture_output=True, text=True, timeout=6)
        rows = json.loads(result.stdout) if result.returncode == 0 else []
        for row in rows:
            value = row.get('value', {})
            if (row.get('integrationID') == 'deepseek' and row.get('active') is True
                    and value.get('type') == 'key' and isinstance(value.get('key'), str)):
                return value['key']
    except (OSError, ValueError, TypeError, subprocess.TimeoutExpired):
        pass
    raise BalanceError('Connect DeepSeek in OpenCode or set DEEPSEEK_API_KEY in the session environment.')


def read_balance():
    request = urllib.request.Request(ENDPOINT, headers={
        'Authorization': 'Bearer ' + api_key(), 'Accept': 'application/json',
        'User-Agent': 'omarchy-agent-usage/1',
    })
    try:
        with urllib.request.build_opener(NoRedirect()).open(request, timeout=10) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        if error.code in (401, 403):
            raise BalanceError('DeepSeek rejected the saved credential; reconnect DeepSeek in OpenCode.') from None
        raise BalanceError('DeepSeek balance returned HTTP ' + str(error.code) + '; refresh later.') from None
    except (OSError, ValueError):
        raise BalanceError('DeepSeek balance is unavailable; refresh later.') from None


def balance_value(payload):
    try:
        wallets = payload['balance_infos']
        if not isinstance(wallets, list) or not wallets:
            raise ValueError('No wallet')
        # Keep currencies separate. The native panel has one balance per provider;
        # prefer USD when supplied, otherwise show CNY as CNY without conversion.
        wallet = next((w for w in wallets if w.get('currency') == 'USD'), wallets[0])
        if wallet['currency'] not in ('USD', 'CNY'):
            raise ValueError('Unsupported currency')
        total = Decimal(wallet['total_balance'])
        if not total.is_finite() or not math.isfinite(float(total)):
            raise ValueError('Invalid balance')
    except (KeyError, ValueError, TypeError, InvalidOperation, OverflowError):
        raise BalanceError('DeepSeek balance response changed; collector review is required.') from None
    return {'remaining': float(max(Decimal(0), total)), 'currency': wallet['currency'],
            'funded': 0, 'spent': 0, 'estimated': False}


def collect(previous=None):
    record = {'schemaVersion': 1, 'id': 'deepseek', 'name': 'DeepSeek',
              'updatedAt': datetime.now(timezone.utc).isoformat(), 'scope': 'account',
              'hasLocalStats': False, 'hasPromptStats': False, 'ready': False,
              'tierLabel': 'API balance', 'usageStatusText': '', 'authHelpText': '', 'limits': []}
    try:
        payload = read_balance()
        record['balance'] = balance_value(payload)
        record['balanceAsOf'] = record['updatedAt']
        record['ready'] = True
        if payload.get('is_available') is False:
            record['usageStatusText'] = 'Balance insufficient for API calls'
    except BalanceError as error:
        record['usageStatusText'] = 'Balance unavailable'
        record['authHelpText'] = str(error)
        if previous and previous.get('balance'):
            record['balance'] = previous['balance']
            record['balanceAsOf'] = previous.get('balanceAsOf', previous.get('updatedAt', ''))
            record['authHelpText'] += ' Showing the last successful balance from ' + record['balanceAsOf'] + '.'
    return record


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--force', action='store_true')
    parser.add_argument('--limits-only', action='store_true')
    args = parser.parse_args()
    cache = Path(os.environ.get('XDG_CACHE_HOME', str(Path.home() / '.cache'))) / 'omarchy/agents/deepseek.json'
    previous = None
    fresh = False
    try:
        previous = json.loads(cache.read_text())
        fresh = time.time() - cache.stat().st_mtime < 60
    except (OSError, ValueError):
        pass
    if fresh and not args.force:
        record = previous
    else:
        record = collect(previous)
        cache.parent.mkdir(parents=True, exist_ok=True)
        fd, name = tempfile.mkstemp(dir=cache.parent, prefix='.deepseek-')
        try:
            with os.fdopen(fd, 'w') as stream:
                json.dump(record, stream)
            os.replace(name, cache)
        finally:
            Path(name).unlink(missing_ok=True)
    print(json.dumps(record, separators=(',', ':')))


if __name__ == '__main__':
    main()
