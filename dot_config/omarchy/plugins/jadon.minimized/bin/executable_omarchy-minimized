#!/usr/bin/env bash
# omarchy:summary=Minimize a window to special:minimized, or restore one
# omarchy:args=minimize [window-address] | restore <window-address> [--here] | close <window-address> | prune | previews | label <address> | list
#
# Hyprland has no minimize. Omarchy hides a window by moving it to the
# special:minimized workspace, which is what the dock reads. This helper does
# that from any workspace, not only floating ones, and remembers what a window
# needs to come back: its workspace, monitor, floating state, exact geometry,
# pinned state, and fullscreen state.
#
# State lives in ${XDG_STATE_HOME:-~/.local/state}/omarchy/minimized/state.json,
# keyed by window address. The matching origin workspace is also written to a
# window tag, so a window minimized by something else still restores.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/minimized"
STATE_FILE="$STATE_DIR/state.json"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/minimized"
MINIMIZED_WORKSPACE="special:minimized"
TAG_PREFIX="omarchy-minimized-from-"

die() {
  printf 'omarchy-minimized: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing $1"
}

need hyprctl
need jq

mkdir -p "$STATE_DIR" "$CACHE_DIR"
[[ -s $STATE_FILE ]] || printf '{"version":1,"windows":{}}\n' >"$STATE_FILE"

# One writer at a time. The lock is advisory and kept for the whole command,
# which is why restore holds it through its short settling delays.
exec 9>"$STATE_DIR/state.lock"
flock -w 3 9 2>/dev/null || true

clients_json() {
  hyprctl clients -j
}

window_json() {
  clients_json | jq -c --arg address "$1" 'first(.[] | select(.address == $address)) // empty'
}

active_address() {
  hyprctl activewindow -j | jq -r '.address // empty'
}

active_workspace_id() {
  hyprctl activeworkspace -j | jq -r '.id // empty'
}

# ------------------------------------------------------- app labels + previews
#
# The row says what the window *is*, not what Hyprland calls its class. GUI apps
# get their desktop entry name in QML; terminals and Omarchy TUIs get a label
# here. For a terminal, that means the foreground process on the pane's tty
# (opencode, nvim, btop), or the Omarchy script the terminal is presenting
# (omarchy-update). Wezterm windows need `wezterm cli` because the GUI process
# does not own the shell: its mux server does.

wezterm_tty() {
  local pid=$1 pane
  command -v wezterm >/dev/null 2>&1 || return 0
  pane=$(timeout 2 wezterm cli list-clients --format json 2>/dev/null |
    jq -r --argjson pid "$pid" '.[] | select(.pid == $pid) | .focused_pane_id' | head -1)
  [[ -n $pane && $pane != null ]] || return 0
  timeout 2 wezterm cli list --format json 2>/dev/null |
    jq -r --argjson pane "$pane" '.[] | select(.pane_id == $pane) | .tty_name' | head -1
}

# The newest child that leads its own session on a tty is the terminal's shell.
terminal_tty() {
  local pid=$1 shell_pid="" children_file child stat session tty_nr
  for children_file in /proc/"$pid"/task/*/children; do
    [[ -r $children_file ]] || continue
    read -ra children <"$children_file" || true
    for child in "${children[@]}"; do
      ((child > ${shell_pid:-0})) && shell_pid=$child
    done
  done
  [[ -n $shell_pid ]] || return 0
  read -r stat <"/proc/$shell_pid/stat" 2>/dev/null || return 0
  read -r _ _ _ session tty_nr _ <<<"${stat##*) }"
  ((session == shell_pid && tty_nr != 0)) || return 0
  readlink -f "/proc/$shell_pid/fd/0" 2>/dev/null
}

# The foreground process group's leader on a tty, as pid<TAB>comm<TAB>args.
foreground() {
  local tty=${1#/dev/} p g t c a
  while read -r p g t c a; do
    [[ -n $p && $g == "$t" ]] || continue
    printf '%s\t%s\t%s\n' "$p" "$c" "$a"
    return
  done < <(ps -t "$tty" -o pid=,pgid=,tpgid=,comm=,args= 2>/dev/null)
}

# Walk up from the foreground process looking for the Omarchy script that owns
# it, so pacman still reads as "Omarchy Update" rather than "Pacman".
ancestor_name() {
  local p=$1 name="" comm args parent tok
  while [[ $p =~ ^[0-9]+$ ]] && ((p > 1)); do
    read -r comm args < <(ps -o comm=,args= -p "$p" 2>/dev/null)
    for tok in $args; do
      tok=${tok%;}
      if [[ $tok == *omarchy-* ]]; then
        if [[ $tok == */* ]]; then name=$(basename "$tok"); else name=$tok; fi
        break
      fi
    done
    [[ -n $name ]] && break
    parent=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
    [[ -z $parent || $parent == "$p" ]] && break
    p=$parent
  done
  printf '%s' "$name"
}

title_case() {
  printf '%s' "$1" | sed -e 's/[-_]/ /g' -e 's/\b\([a-z]\)/\u\1/g'
}

omarchy_label() {
  case $1 in
    omarchy-update) printf 'Omarchy Update' ;;
    omarchy-install-app) printf 'Omarchy Install App' ;;
    omarchy-install-font) printf 'Omarchy Install Font' ;;
    omarchy-show-logo | omarchy-show-done) printf 'Omarchy' ;;
    *) printf 'Omarchy %s' "$(title_case "${1#omarchy-}")" ;;
  esac
}

display_name() {
  local name=${1##*/}
  name=${name%.sh}
  case $name in
    nvim | vim) printf 'Neovim' ;;
    opencode | opencode.exe) printf 'OpenCode' ;;
    lazygit) printf 'Lazygit' ;;
    yazi) printf 'Yazi' ;;
    ssh) printf 'SSH' ;;
    python | python3) printf 'Python' ;;
    node) printf 'Node' ;;
    cargo) printf 'Cargo' ;;
    npm | pnpm | bun) printf '%s' "$name" ;;
    tmux | zellij | screen) printf '%s' "$name" ;;
    omarchy-*) omarchy_label "$name" ;;
    "") printf '' ;;
    *) title_case "$name" ;;
  esac
}

command_label() {
  local comm=$1 args=$2 tok name=""
  case $comm in
    bash | zsh | fish | sh | dash | nu) ;;
    *) display_name "$comm"; return ;;
  esac
  for tok in $args; do
    tok=${tok%;}
    case $tok in
      -* | bash | zsh | fish | sh | dash | nu) continue ;;
    esac
    name=${tok##*/}
    break
  done
  [[ -n $name ]] && display_name "$name"
}

terminal_name() {
  case $1 in
    org.wezfurlong.wezterm) printf 'WezTerm' ;;
    foot) printf 'Foot' ;;
    Alacritty | alacritty) printf 'Alacritty' ;;
    kitty) printf 'Kitty' ;;
    com.mitchellh.ghostty) printf 'Ghostty' ;;
    org.gnome.Console) printf 'Console' ;;
    *) printf '' ;;
  esac
}

is_terminal_class() {
  case $1 in
    org.wezfurlong.wezterm | foot | Alacritty | alacritty | kitty | com.mitchellh.ghostty | org.gnome.Console) return 0 ;;
    *) return 1 ;;
  esac
}

# What is running inside a terminal, or empty when it is just a shell prompt.
process_label() {
  local pid=$1 class=$2 tty fg fg_pid comm args ancestor label
  [[ -n $pid ]] || return 0
  case $class in
    org.wezfurlong.wezterm) tty=$(wezterm_tty "$pid") ;;
    *) tty=$(terminal_tty "$pid") ;;
  esac
  [[ -n $tty ]] || return 0
  fg=$(foreground "$tty")
  [[ -n $fg ]] || return 0
  IFS=$'\t' read -r fg_pid comm args <<<"$fg"
  ancestor=$(ancestor_name "$fg_pid")
  if [[ -n $ancestor ]]; then
    display_name "$ancestor"
    return
  fi
  command_label "$comm" "$args"
}

omarchy_class_label() {
  local name=${1#org.omarchy.}
  case $name in
    agent) printf 'Omarchy Agent' ;;
    terminal) printf 'Omarchy Terminal' ;;
    btop) printf 'btop' ;;
    nvim) printf 'Neovim' ;;
    update) printf 'Omarchy Update' ;;
    about) printf 'About' ;;
    *) title_case "$name" ;;
  esac
}

window_app_label() {
  local window=$1 class pid label
  class=$(jq -r '.class // .initialClass // ""' <<<"$window")
  pid=$(jq -r '.pid // empty' <<<"$window")
  case $class in
    org.omarchy.terminal)
      label=$(process_label "$pid" "$class")
      printf '%s' "${label:-Omarchy Terminal}"
      ;;
    org.omarchy.*) omarchy_class_label "$class" ;;
    *)
      if is_terminal_class "$class"; then
        label=$(process_label "$pid" "$class")
        printf '%s' "${label:-$(terminal_name "$class")}"
      fi
      ;;
  esac
}

preview_path() {
  printf '%s/%s.png' "$CACHE_DIR" "$1"
}

capture_preview() {
  local address=$1 stable=$2
  command -v grim >/dev/null 2>&1 || return 0
  [[ -n $address && -n $stable && $stable != null ]] || return 0
  grim -s 0.35 -T "$stable" "$(preview_path "$address")" >/dev/null 2>&1 || true
}

# Refresh thumbnails of every window still parked, and drop the pictures of
# windows that have left. Capturing a hidden window works: it is still rendered.
cmd_previews() {
  local live=() address stable file name found addr
  while IFS=$'\t' read -r address stable; do
    [[ -n $address && -n $stable ]] || continue
    capture_preview "$address" "$stable"
    live+=("$address")
  done < <(clients_json | jq -r '.[] | select(.workspace.name == "'"$MINIMIZED_WORKSPACE"'") | [.address, .stableId] | @tsv')

  for file in "$CACHE_DIR"/*.png; do
    [[ -e $file ]] || continue
    name=$(basename "$file" .png)
    found=0
    for addr in "${live[@]}"; do
      [[ $addr == "$name" ]] && found=1 && break
    done
    ((found)) || rm -f "$file"
  done
}

# ---------------------------------------------------------------- state file

state_get() {
  jq -c --arg address "$1" '.windows[$address] // empty' "$STATE_FILE" 2>/dev/null
}

state_put() {
  local address=$1 entry=$2 tmp
  tmp=$(mktemp "$STATE_DIR/.state.XXXXXX") || return 1
  if jq --arg address "$address" --argjson entry "$entry" \
      '.windows[$address] = $entry' "$STATE_FILE" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$STATE_FILE"
  else
    rm -f "$tmp"
    return 1
  fi
}

state_drop() {
  local address=$1 tmp
  tmp=$(mktemp "$STATE_DIR/.state.XXXXXX") || return 1
  if jq --arg address "$address" 'del(.windows[$address])' "$STATE_FILE" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$STATE_FILE"
  else
    rm -f "$tmp"
    return 1
  fi
}

# Entries whose window is gone or no longer parked on the minimized workspace
# are stale: closed apps, windows restored from the dock, or windows the user
# moved out by hand.
cmd_prune() {
  local live tmp file name found address
  live=$(clients_json | jq -c '[.[] | select(.workspace.name == "'"$MINIMIZED_WORKSPACE"'") | .address]') || return 0
  tmp=$(mktemp "$STATE_DIR/.state.XXXXXX") || return 1
  if jq --argjson live "$live" \
      '.windows |= with_entries(select(.key as $key | $live | index($key)))' \
      "$STATE_FILE" >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$STATE_FILE"
  else
    rm -f "$tmp"
  fi

  for file in "$CACHE_DIR"/*.png; do
    [[ -e $file ]] || continue
    name=$(basename "$file" .png)
    found=0
    for address in $(jq -r '.[]' <<<"$live"); do
      [[ $address == "$name" ]] && found=1 && break
    done
    ((found)) || rm -f "$file"
  done
}

# ------------------------------------------------------------ workspace keys

# A Lua dispatcher argument: numbers stay numbers, everything else is quoted.
lua_workspace() {
  local value=$1
  if [[ $value =~ ^-?[0-9]+$ ]]; then
    printf '%s' "$value"
  else
    printf '"%s"' "${value//\"/\\\"}"
  fi
}

origin_tag() {
  local id=$1 name=$2
  if [[ $id =~ ^[0-9]+$ ]]; then
    printf '%s%s' "$TAG_PREFIX" "$id"
  else
    printf '%s%s' "$TAG_PREFIX" "$(jq -rn --arg name "$name" '$name | gsub("[^A-Za-z0-9]+"; "-")')"
  fi
}

# The origin tag is a fallback for windows no state entry names. A window that
# has been minimized more than once should not accumulate them.
clear_origin_tags() {
  local address=$1 window tag
  window=$(window_json "$address")
  [[ -n $window ]] || return 0
  while IFS= read -r tag; do
    [[ -n $tag ]] || continue
    hyprctl dispatch "hl.dsp.window.tag({ tag = \"-$tag\", window = \"address:$address\" })" >/dev/null 2>&1
  done < <(jq -r --arg prefix "$TAG_PREFIX" '.tags[]? | select(startswith($prefix))' <<<"$window")
}

monitor_name_for() {
  local id=$1
  [[ $id =~ ^[0-9]+$ ]] || return 0
  hyprctl monitors -j | jq -r --argjson id "$id" 'first(.[] | select(.id == $id) | .name) // empty'
}

# ---------------------------------------------------------------- minimize

cmd_minimize() {
  local address=${1:-}
  [[ -n $address ]] || address=$(active_address)
  [[ -n $address ]] || die "no active window"
  [[ $address == 0x* ]] || address="0x$address"

  local window workspace_name workspace_id focused=0 origin
  window=$(window_json "$address")
  [[ -n $window ]] || die "window not found: $address"

  workspace_name=$(jq -r '.workspace.name // ""' <<<"$window")
  [[ $workspace_name != "$MINIMIZED_WORKSPACE" ]] || return 0
  workspace_id=$(jq -r '.workspace.id // empty' <<<"$window")
  [[ $(active_address) == "$address" ]] && focused=1

  origin=$(origin_tag "$workspace_id" "$workspace_name")
  clear_origin_tags "$address"
  hyprctl dispatch "hl.dsp.window.tag({ tag = \"+$origin\", window = \"address:$address\" })" >/dev/null 2>&1

  # A pinned window is visible on every workspace, including while parked, so
  # take the pin off now and put it back on restore.
  if [[ $(jq -r '.pinned' <<<"$window") == true ]]; then
    hyprctl dispatch "hl.dsp.window.pin({ action = \"disable\", window = \"address:$address\" })" >/dev/null 2>&1
  fi

  local entry app stable
  stable=$(jq -r '.stableId // empty' <<<"$window")
  capture_preview "$address" "$stable"
  app=$(window_app_label "$window")
  entry=$(jq -c \
    --arg monitor "$(monitor_name_for "$(jq -r '.monitor' <<<"$window")")" \
    --arg app "$app" \
    --argjson now "$(date +%s%3N)" \
    '{
      address,
      class,
      initialClass,
      title,
      app: $app,
      workspace: { id: (.workspace.id // null), name: (.workspace.name // "") },
      monitor: $monitor,
      monitorId: .monitor,
      floating,
      at,
      size,
      pinned,
      fullscreen: (.fullscreen // 0),
      fullscreenClient: (.fullscreenClient // .fullscreen // 0),
      minimizedAt: $now
    }' <<<"$window")
  state_put "$address" "$entry"

  hyprctl dispatch \
    "hl.dsp.window.move({ workspace = \"$MINIMIZED_WORKSPACE\", window = \"address:$address\", follow = false })" \
    >/dev/null 2>&1

  # The focused window was carrying focus; without this the next window opened
  # would join it on the hidden workspace. Only refocus when the window really
  # held focus, so minimizing another workspace's window never moves the view.
  if (( focused )); then
    if [[ -n $workspace_id ]]; then
      hyprctl dispatch "hl.dsp.focus({ workspace = $(lua_workspace "$workspace_id") })" >/dev/null 2>&1
    elif [[ $workspace_name == special:* ]]; then
      hyprctl dispatch "hl.dsp.focus({ workspace = $(lua_workspace "$workspace_name") })" >/dev/null 2>&1
    fi
  fi

  cmd_prune
}

# ---------------------------------------------------------------- restore

# Hyprland keeps a floating window's geometry across the special-workspace
# round trip. When something did move it — a different monitor, a layout change
# — put back the saved size and position, but only within the monitor it came
# from: global coordinates from another output would fling it off screen.
restore_geometry() {
  local address=$1 entry=$2 window saved_size current_size saved_monitor monitor
  [[ $(jq -r '.floating' <<<"$entry") == true ]] || return 0

  window=$(window_json "$address")
  [[ -n $window ]] || return 0

  if [[ $(jq -r '.floating' <<<"$window") != true ]]; then
    hyprctl dispatch "hl.dsp.window.float({ action = \"enable\", window = \"address:$address\" })" >/dev/null 2>&1
    sleep 0.05
    window=$(window_json "$address")
    [[ -n $window ]] || return 0
  fi

  saved_size=$(jq -c '.size // empty' <<<"$entry")
  current_size=$(jq -c '.size' <<<"$window")
  if [[ -n $saved_size && $saved_size != null && $saved_size != "$current_size" ]]; then
    hyprctl dispatch "hl.dsp.window.resize({ x = $(jq '.[0]' <<<"$saved_size"), y = $(jq '.[1]' <<<"$saved_size"), window = \"address:$address\" })" >/dev/null 2>&1
    sleep 0.05
    window=$(window_json "$address")
    [[ -n $window ]] || return 0
  fi

  saved_monitor=$(jq -r '.monitor // empty' <<<"$entry")
  monitor=$(monitor_name_for "$(jq -r '.monitor' <<<"$window")")
  if [[ -n $saved_monitor && $saved_monitor == "$monitor" ]]; then
    local saved_at current_at
    saved_at=$(jq -c '.at // empty' <<<"$entry")
    current_at=$(jq -c '.at' <<<"$window")
    if [[ -n $saved_at && $saved_at != null && $saved_at != "$current_at" ]]; then
      hyprctl dispatch "hl.dsp.window.move({ x = $(jq '.[0]' <<<"$saved_at"), y = $(jq '.[1]' <<<"$saved_at"), window = \"address:$address\" })" >/dev/null 2>&1
    fi
  fi
}

restore_fullscreen() {
  local address=$1 entry=$2 state client_state
  state=$(jq -r '.fullscreen // 0' <<<"$entry")
  client_state=$(jq -r '.fullscreenClient // 0' <<<"$entry")
  (( state > 0 )) || return 0
  hyprctl dispatch \
    "hl.dsp.window.fullscreen_state({ internal = $state, client = $client_state, window = \"address:$address\" })" \
    >/dev/null 2>&1
}

cmd_restore() {
  local address=${1:-}
  [[ -n $address ]] || die "restore needs a window address"
  [[ $address == 0x* ]] || address="0x$address"
  shift || true

  local here=0
  while (($# > 0)); do
    case $1 in
      --here | -h) here=1 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done

  local window entry
  window=$(window_json "$address")
  [[ -n $window ]] || die "window not found: $address"
  entry=$(state_get "$address")
  [[ -n $entry ]] || entry='{}'

  local target=""
  if ((here)); then
    target=$(active_workspace_id)
  else
    local name id
    name=$(jq -r '.workspace.name // empty' <<<"$entry")
    id=$(jq -r '.workspace.id // empty' <<<"$entry")
    if [[ $name == special:* ]]; then
      target=$name
    elif [[ -n $id ]]; then
      # Hyprland creates an empty workspace again when a window returns to it,
      # so an id with no live workspace is still a valid destination.
      target=$id
    else
      # A window minimized by the stock command (or before this plugin saved
      # state) still carries its origin workspace in a tag.
      local tag
      tag=$(jq -r --arg prefix "$TAG_PREFIX" \
        'first(.tags[]? | select(startswith($prefix)) | ltrimstr($prefix)) // empty' <<<"$window")
      [[ $tag =~ ^[0-9]+$ ]] && target=$tag
    fi
  fi
  [[ -n $target ]] || target=$(active_workspace_id)
  [[ -n $target ]] || die "no workspace to restore to"

  # Restored windows are simply back, without animating in from nowhere.
  hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"no_anim\", value = \"1\", window = \"address:$address\" })" >/dev/null 2>&1
  hyprctl dispatch \
    "hl.dsp.window.move({ workspace = $(lua_workspace "$target"), window = \"address:$address\", follow = false })" \
    >/dev/null 2>&1
  sleep 0.12

  # A window going back to a hidden special workspace would otherwise take
  # focus while staying invisible. Show the workspace it belongs to.
  if [[ $target == special:* ]]; then
    hyprctl dispatch "hl.dsp.focus({ workspace = $(lua_workspace "$target") })" >/dev/null 2>&1
  fi

  restore_geometry "$address" "$entry"
  restore_fullscreen "$address" "$entry"

  hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1
  hyprctl dispatch "hl.dsp.window.alter_zorder({ mode = \"top\", window = \"address:$address\" })" >/dev/null 2>&1

  if [[ $(jq -r '.pinned' <<<"$entry") == true ]]; then
    hyprctl dispatch "hl.dsp.window.pin({ action = \"enable\", window = \"address:$address\" })" >/dev/null 2>&1
  fi

  clear_origin_tags "$address"

  (
    sleep 0.35
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"no_anim\", value = \"unset\", window = \"address:$address\" })" >/dev/null 2>&1
  ) &

  state_drop "$address"
  cmd_prune
}

# ---------------------------------------------------------------- close
#
# A close request is polite: the app may answer with a "save changes" dialog.
# That dialog is on the hidden workspace, so if the window survives the request
# it comes back to its origin, focused, with a notification saying why.
cmd_close() {
  local address=${1:-}
  [[ -n $address ]] || die "close needs a window address"
  [[ $address == 0x* ]] || address="0x$address"

  local window app
  window=$(window_json "$address")
  [[ -n $window ]] || return 0
  app=$(state_get "$address" | jq -r '.app // empty' 2>/dev/null)

  hyprctl dispatch "hl.dsp.window.close({ window = \"address:$address\" })" >/dev/null 2>&1
  sleep 0.6

  window=$(window_json "$address")
  if [[ -z $window ]]; then
    cmd_prune
    return 0
  fi

  cmd_restore "$address"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Omarchy" "Close needs an answer" \
      "${app:-The window} is asking before it closes." >/dev/null 2>&1 || true
  fi
}

# ---------------------------------------------------------------- reporting

cmd_list() {
  local live
  live=$(clients_json | jq -c '[.[] | select(.workspace.name == "'"$MINIMIZED_WORKSPACE"'")]')
  jq -c --argjson live "$live" '
    .windows as $state
    | $live
    | map(. + { saved: ($state[.address] // null) })
    | sort_by([(.saved.minimizedAt // 0), .class])
    | reverse
  ' "$STATE_FILE" 2>/dev/null || printf '[]\n'
}

cmd_label() {
  local address=${1:-}
  [[ -n $address ]] || die "label needs a window address"
  [[ $address == 0x* ]] || address="0x$address"
  local window
  window=$(window_json "$address")
  [[ -n $window ]] || die "window not found: $address"
  window_app_label "$window"
  printf '\n'
}

case ${1:-} in
  minimize)
    shift
    cmd_minimize "${1:-}"
    ;;
  restore)
    shift
    cmd_restore "$@"
    ;;
  close)
    shift
    cmd_close "${1:-}"
    ;;
  prune)
    cmd_prune
    ;;
  previews)
    cmd_previews
    ;;
  label)
    shift
    cmd_label "${1:-}"
    ;;
  list)
    cmd_list
    ;;
  *)
    printf 'usage: %s {minimize [window-address] | restore <window-address> [--here] | close <window-address> | prune | previews | label <address> | list}\n' "$0" >&2
    exit 2
    ;;
esac
