{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  // Compaction reserves `buffer` of each model's window as free space, then
  // starts when the conversation reaches the rest. 60% = compact at ~40% full.
  // Background precompute begins at 85% of that threshold (about 34% of the
  // window) instead of pausing the session at the threshold. The reserve keeps
  // sessions smaller so responses stay fast even on large-context models.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 25000
    },
    "buffer": "50%"
  },
  "experimental": {
    "subagent_depth": 2,
    "background_compaction": true
  },
  "agents": {
    "plan": {
      "disabled": true
    },
    "build": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "compaction": {
      "model": "deepseek/deepseek-flash#max"
    }
  },
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": {
          "variants": [
            {
              "id": "none",
              "body": {
                "thinking": {
                  "type": "disabled"
                }
              }
            }
          ]
        }
      }
    },
    "openai": {
      "settings": {
        "compaction": {
          "type": "native"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "pdf": {
        "type": "local",
        "command": [
          "pdf-mcp"
        ],
        "timeout": {
          "startup": 120000,
          "execution": 300000
        }
      }
    }
  },
  "permissions": [
    {
      "action": "pdf_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_create",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_field_set",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_field_patch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_evidence_add",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_evidence_remove",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_finalize",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_status",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_load_approved",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_create",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_overview_put",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_finding_put",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_finding_remove",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_finalize",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_load",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_summary",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_create",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_outcome_put",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_summary_put",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_finding_put",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_finding_remove",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_finalize",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_load",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_summary",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "report_create",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "report_content_put",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "report_content_remove",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "report_finalize",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "report_load",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "report_summary",
      "resource": "*",
      "effect": "deny"
    }
  ],
}
