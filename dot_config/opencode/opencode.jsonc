{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "system",
  // buffer is the room kept free, so 30% means compaction starts at ~70% of
  // the window (~700k of 1M). Keep.tokens plus the fixed system prompt must
  // stay below that trigger, or compaction cannot restore headroom.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 32000
    },
    "buffer": "30%"
  },
  "experimental": {
    "subagent_depth": 1,
    "background_compaction": true
  },
  "agents": {
    "plan": {
      "disabled": true
    },
    "build": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "compaction": {
      "model": "deepseek/deepseek-flash#max"
    }
  },
  "mcp": {
    "servers": {
      "pdf": {
        "type": "local",
        "command": [
          "pdf-mcp"
        ],
        "timeout": {
          "startup": 120000,
          "execution": 300000
        }
      },
      "browse": {
        "type": "local",
        "command": [
          "/home/jadon/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  },
  "plugins": [
    "opencode-mobile-notifications",
    "./plugins/arrowlake-theme"
  ],
}
