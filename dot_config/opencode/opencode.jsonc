{
    "$schema": "https://opencode.ai/config.json",
    "model": "deepseek/deepseek-v4-pro",
    "small_model": "deepseek/deepseek-v4-flash",
    "default_agent": "plan",
    "agent": {
        "general": {
            "disable": true
        },
        "explore": {
            "disable": true
        },
        "scout": {
            "disable": true
        },
    },
    "compaction": {
        "auto": true,
        "prune": true,
        "tail_turns": 12,
        "preserve_recent_tokens": 25000,
        "reserved": 15000
    },
}
