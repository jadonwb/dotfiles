{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-sol#high",
  "default_agent": "planner",
  "experimental": {
    "subagent_depth": 2
  },
  "agents": {
    "title": {
      "model": "opencode/deepseek-v4-flash"
    },
    "plan": {
      "disabled": true
    },
    "build": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 25000
    },
    "buffer": 15000
  },
  "permissions": [
    {
      "action": "pdf_read",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "pdf_search",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_create",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_field_set",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_field_patch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_evidence_add",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_evidence_remove",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_finalize",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_status",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "plan_load_approved",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_create",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_overview_put",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_finding_put",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_finding_remove",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_finalize",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_load",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "evidence_summary",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_create",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_outcome_put",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_summary_put",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_finding_put",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_finding_remove",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_finalize",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_load",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "review_summary",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "report_create",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "report_content_put",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "report_content_remove",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "report_finalize",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "report_load",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "report_summary",
      "resource": "*",
      "effect": "deny"
    }
  ],
}
