{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  // Keep 30% of the selected model's context budget free
  "compaction": {
    "background": true,
    "auto": true,
    "keep": {
      "tokens": 32000
    },
    "buffer": "30%"
  },
  "agents": {
    "plan": {
      "disabled": true
    },
    "build": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "compaction": {
      "model": "deepseek/deepseek-flash#max"
    }
  },
  "mcp": {
    "servers": {
      "pdf": {
        "type": "local",
        "command": [
          "/home/jadon/.local/bin/pdf-mcp"
        ],
        "timeout": {
          "startup": 120000,
          "execution": 300000
        }
      },
      "browse": {
        "type": "local",
        "command": [
          "/home/jadon/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      },
      "desktop": {
        "type": "local",
        "command": [
          "/home/jadon/.local/bin/uv",
          "run",
          "--directory",
          "/home/jadon/c/desktop-mcp",
          "desktop-mcp"
        ],
        "environment": {
          "TYPESAFE_API_KEY_COMMAND": "/usr/bin/secret-tool lookup service desktop-mcp key typesafe_api_key"
        },
        "timeout": {
          "startup": 60000,
          "execution": 120000
        }
      }
    }
  },
  "plugins": [
    "opencode-mobile-notifications",
    "./plugins/arrowlake-theme"
  ],
}
