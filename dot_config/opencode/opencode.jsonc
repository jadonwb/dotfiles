{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/gpt-5.6-sol",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "planner",
  "subagent_depth": 2,
  "mcp": {
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ],
      "enabled": true
    }
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 12,
    "preserve_recent_tokens": 25000,
    "reserved": 15000
  }
}
