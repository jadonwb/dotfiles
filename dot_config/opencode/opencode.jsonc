{
    "$schema": "https://opencode.ai/config.json",
    "model": "xai/grok-build-0.1",
    "small_model": "deepseek/deepseek-v4-flash",
    "default_agent": "plan",
    "agent": {
        "general": {
            "disable": true
        },
        "explore": {
            "disable": true
        },
        "scout": {
            "disable": true
        },
    },
    "compaction": {
        "auto": true,
        "prune": true,
        "tail_turns": 6,
        "preserve_recent_tokens": 24000,
        "reserved": 20000
    },
}
