{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/gpt-5.6-sol",
  "default_agent": "planner",
  "experimental": {
    "subagent_depth": 2
  },
  "agents": {
    "title": {
      "model": "opencode/deepseek-v4-flash"
    },
    "plan": {
      "disabled": true
    },
    "build": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 25000
    },
    "buffer": 15000
  },
  "permissions": [
    {
      "action": "pdf_read",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "pdf_search",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "artifact_publish",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "artifact_get",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "artifact_patch",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "plugins": [
    "./plugins/pdf-tools",
    "./plugins/plan-bridge"
  ]
}
