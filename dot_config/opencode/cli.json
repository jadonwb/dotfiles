{
    "$schema": "https://opencode.ai/v2/cli.json",
    "theme": {
        "name": "arrowlake_light",
        "mode": "system"
    },
    "scroll": {
        "speed": 3,
        "acceleration": false
    },
    "keybinds": {
        "app.exit": "alt+q",
        "prompt.editor": "alt+t",
        "service.restart": "alt+r",
        "command.palette.show": "ctrl+space",
        "session.fork": "ctrl+f",
        "session.new": "ctrl+t,<leader>n",
        "session.tab.close": "ctrl+w,<leader>w",
        "variant.cycle": "none",
        "input.delete.word.backward": "ctrl+backspace,alt+backspace",
        "session.line.up": "alt+k",
        "session.line.down": "alt+j",
        "composer.subagent.up": "k,up,ctrl+p",
        "composer.subagent.down": "j,down,ctrl+n",
        "session.child.first": "tab",
        "session.message.user.next": "alt+shift+j",
        "session.message.user.previous": "alt+shift+k",
        "prompt.history.previous": "none",
        "prompt.history.next": "none"
    },
    "prompt": {
        "image_preview": true
    },
    "attention": {
        "notifications": false,
        "sound": false
    },
    "session": {
        "sidebar": "hide",
        "grouping": "auto",
        "verbosity": "low",
        "thinking": "hide"
    },
    "terminal": {
        "title": false
    },
    "plugins": [
        "-opencode.btw",
        "./plugins/btw-panel"
    ],
    "animations": true,
    "cursor": {
        "style": "line"
    }
}
