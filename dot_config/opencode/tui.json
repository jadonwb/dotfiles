{
    "$schema": "https://opencode.ai/tui.json",
    "scroll_speed": 5,
    "scroll_acceleration": {
        "enabled": true
    },
    "diff_style": "auto",
    "keybinds": {
        "app_exit": "alt+q",
        "editor_open": "alt+t",
        "messages_line_up": "alt+k",
        "messages_line_down": "alt+j",
        "command_list": "ctrl+space",
        "history_previous": "none",
        "history_next": "none",
    },
    "attention": {
        "enabled": true,
        "notifications": true,
        "sound": false,
        "volume": 0.0
    }
}
