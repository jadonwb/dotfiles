{{- if eq .machine.type "work" }}
# Ubuntu port: native Omarchy assets, existing user defaults and mise tools.
export OMARCHY_PATH=/usr/share/omarchy
. "$HOME/.config/uwsm/default"
if command -v mise >/dev/null 2>&1; then eval "$(mise env -s bash)"; fi
export PATH="$OMARCHY_PATH/bin:$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
{{- end }}
