+def read_opencode_store_key() -> str:
+  """Read the active DeepSeek key OpenCode V2 keeps in opencode.db."""
+  db = opencode_db()
+  if not db.is_file():
+    return ""
+  try:
+    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
+  except sqlite3.Error:
+    return ""
+  try:
+    conn.execute("PRAGMA query_only = ON")
+    rows = conn.execute(
+      "SELECT value FROM credential WHERE active = 1 AND integration_id = 'deepseek'"
+      " ORDER BY time_updated DESC"
+    ).fetchall()
+  except sqlite3.Error:
+    return ""
+  finally:
+    conn.close()
+  for (raw,) in rows:
+    try:
+      value = json.loads(raw)
+    except Exception:
+      continue
+    if isinstance(value, dict) and value.get("type") == "key":
+      key = str(value.get("key") or "").strip()
+      if key:
+        return key
+  return ""
+
