-- WezTerm session definitions, shown in the custom launcher (launcher.lua).
--
-- Each entry is a session opened as a whole workspace: picking one switches to
-- that workspace, creating it (with this cwd and command) only if it doesn't
-- already exist. Tabs within it are your "windows".
--
-- Fields:
--   label - workspace name / launcher label
--   cwd   - working directory for the spawned shell/program (optional)
--   args  - program + args to run instead of the default shell (optional)

return {
	{ label = "source code", cwd = "~/c" },
	{ label = "dotfiles", cwd = "~/.local/share/chezmoi" },
	{{- if eq .machine.type "work" }}

	{{- else if eq .machine.type "personal" }}
	{ label = "llama-toolboxes", cwd = "~/c/amd-strix-halo-toolboxes/" },
	{ label = "vllm-toolboxes", cwd = "~/c/amd-strix-halo-vllm-toolboxes/" },
	{ label = "comfyui-toolboxes", cwd = "~/c/amd-strix-halo-image-video-toolboxes/" },
	{{- end }}
}
