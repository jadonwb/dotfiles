[user]
	name = Jadon Brutcher
	email = {{ .email | quote  }}
{{- if eq .machine.type "work" }}

[safe]
	directory = *
{{- end}}

[protocol "file"]
	allow = always
{{- if eq .machine.type "personal" }}
[url "git@github.com:"]
	insteadOf = https://github.com/
{{- end}}
[rebase]
	autoStash = true
[merge]
    tool = diffview
[mergetool "diffview"]
	trustExitCode = false
	cmd = diffview-merge \"$MERGED\" \"$BASE\" \"$LOCAL\" \"$REMOTE\"
[mergetool]
    prompt = false
    keepBackup = false
[push]
	useForceIfIncludes = true
