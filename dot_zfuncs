# For my yocto work
reflash() {
    sudo umount "$1"* > /dev/null 2>&1
    sudo dd if=/dev/zero of="$1" bs=1M count=100 && sync
    sudo bmaptool copy "$2" "$1"
}

open() {
  xdg-open "$@" >/dev/null 2>&1 &
}

deref() {
  local f real dir
  for f in "$@"; do
    [[ -L $f ]] || continue

    dir=$(dirname -- "$f")
    real=$(readlink -- "$f") || continue

    rm -- "$f" || continue
    cp -- "$dir/$real" "$f"
  done
}

