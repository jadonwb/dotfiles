#!/usr/bin/env bash

# xdg-terminal-exec entry point for WezTerm.

is_float=0
prev=""

for arg in "$@"; do
  if [[ "$prev" == "--class" && "$arg" == org.omarchy.* ]]; then
    is_float=1
  fi

  if [[ "$arg" == --class=org.omarchy.* ]]; then
    is_float=1
  fi

  prev="$arg"
done

if ((is_float)); then
  exec wezterm \
    --config enable_tab_bar=false \
    start \
    --always-new-process \
    "$@"
else
  exec wezterm \
    start \
    --always-new-process \
    --domain "$(hostname)" \
    "$@"
fi
