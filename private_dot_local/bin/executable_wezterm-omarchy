#!/usr/bin/env bash

# xdg-terminal-exec entry point for WezTerm.
#
# Omarchy launches its floating TUIs via:
#   xdg-terminal-exec --app-id=org.omarchy.<name> -e <command>
# which xdg-terminal-exec translates (via X-TerminalArgAppId) into:
#   wezterm-omarchy --class=org.omarchy.<name> -- <command>

is_float=0
prev=""
for arg in "$@"; do
  if [[ "$prev" == "--class" && "$arg" == org.omarchy.* ]]; then
    is_float=1
  fi
  if [[ "$arg" == --class=org.omarchy.* ]]; then
    is_float=1
  fi
  prev="$arg"
done

# First free numeric workspace (tmux-style: 0, 1, 2, ...), reusing freed slots.
next_workspace() {
  local used n=0
  used="$(env -u WEZTERM_UNIX_SOCKET wezterm cli --prefer-mux --no-auto-start list --format json 2>/dev/null |
    jq -r '.[].workspace' 2>/dev/null |
    grep -E '^[0-9]+$' | sort -n)" || true
  while printf '%s\n' "$used" | grep -qx "$n"; do
    n=$((n + 1))
  done
  printf '%s\n' "$n"
}

if ((is_float)); then
  exec wezterm --config enable_tab_bar=false start --always-new-process "$@"
else
  WS="$(next_workspace)"
  exec wezterm start --always-new-process --domain unix --workspace "$WS" "$@"
fi
