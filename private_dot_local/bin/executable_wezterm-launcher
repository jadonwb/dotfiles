#!/usr/bin/env bash

# Open a fresh WezTerm window attached to the shared `unix` mux and land
# directly in the custom launcher (launcher.lua). Bound to SUPER + ALT + RETURN.
#
# The env var is read by the `gui-attached` hook in wezterm.lua; it must be set
# here and the GUI must be a fresh process (--always-new-process) so the hook
# runs inside this new window.

export WEZTERM_OPEN_LAUNCHER=1
exec wezterm start --always-new-process --domain unix
