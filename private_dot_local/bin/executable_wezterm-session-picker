#!/usr/bin/env bash

# Open a WezTerm window attached to the shared `unix` mux and immediately
# show the launcher menu (sessions / workspaces / domains). Bound to
# SUPER + ALT + RETURN.
#
# The env var is read by the `gui-attached` hook in wezterm.lua. It must be
# set here and the GUI must be a fresh process (--always-new-process), because
# the hook runs inside the GUI process that this launcher starts — a
# single-instance delegation (or --new-tab) would route to an already-running
# GUI that did not inherit WEZTERM_OPEN_LAUNCHER.

export WEZTERM_OPEN_LAUNCHER=1
exec wezterm start --always-new-process --domain unix
